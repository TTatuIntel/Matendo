# =====================================================================
# Matendo Medics — PRODUCTION .htaccess
# Drop-in replacement for the root-level .htaccess when deploying to a
# domain root (e.g. matendohealth.com). Replace the existing .htaccess
# with this file during deployment:
#     mv .htaccess .htaccess.dev && mv deploy/.htaccess.production .htaccess
# =====================================================================

# =====================================================================
# Routing — pages live in public/, auth/, api/, legal/.
# Both .php and extensionless URLs route to the same file.
# =====================================================================
RewriteEngine On
RewriteBase /

# --- Force HTTPS (the cert is on Apache; redirect any plain HTTP) -----
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Canonical host (drop www) ---------------------------------------
RewriteCond %{HTTP_HOST} ^www\.matendohealth\.com$ [NC]
RewriteRule ^(.*)$ https://matendohealth.com/$1 [L,R=301]

# --- Canonical clean URLs --------------------------------------------
# /index.php (or /index) → /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.php)?[\s?] [NC]
RewriteRule ^index(\.php)?$ / [R=301,L,QSA]

# /<anything>.php → /<anything>  (skip api/, which JS posts to directly)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(?!api/)[^?\s]+\.php(\?[^\s]*)?\s [NC]
RewriteRule ^(?!api/)(.+?)\.php$ /$1 [R=301,L,QSA]

# --- Internal routing -------------------------------------------------
# Root and /home → public/index.php
RewriteRule ^(home/?)?$ public/index.php [L,QSA]

# Pass-through for real files and directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /auth/<name> → auth/<name>.php  (same for api, legal)
RewriteCond %{DOCUMENT_ROOT}/$1/$2.php -f
RewriteRule ^(auth|api|legal)/([a-zA-Z0-9_-]+)$ $1/$2.php [L,QSA]

# Top-level <name> → public/<name>.php
RewriteCond %{DOCUMENT_ROOT}/public/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)$ public/$1.php [L,QSA]

# =====================================================================
# Security hardening
# =====================================================================
Options -Indexes -MultiViews
DirectoryIndex index.php

# Deny access to dotfiles and sensitive metadata.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^\.env|composer\.(json|lock)|package\.json|\.gitignore|\.gitattributes|README\.md|DEPLOY\.md)$">
    Require all denied
</FilesMatch>

# Deny direct access to non-public folders.
RedirectMatch 403 ^/(config|includes|sql|storage|deploy|\.git)(/|$)

# --- Security headers ------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com data:; script-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # HSTS — only enabled in production over HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# --- PHP hardening ---------------------------------------------------
<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
    php_value session.use_strict_mode 1
</IfModule>

# --- Caching for static assets --------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# --- Old .html bookmarks redirect to clean URLs ---------------------
RewriteRule ^index\.html$    /         [R=301,L]
RewriteRule ^about\.html$    /about    [R=301,L]
RewriteRule ^contact\.html$  /contact  [R=301,L]
RewriteRule ^careers\.html$  /careers  [R=301,L]
RewriteRule ^hire\.html$     /hire     [R=301,L]
RewriteRule ^join\.html$     /join     [R=301,L]
