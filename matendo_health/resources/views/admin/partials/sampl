@push('scripts')
<script>
let currentApplicationId = null;

function openModal(refNumber, name, email, phone, address, profession, specialization, experience, startDate, licenseNumber, resumeUrl, licenseUrl, certificationsUrl, applicationId) {
    currentApplicationId = applicationId;
    document.getElementById('modalRefNumber').textContent = refNumber;
    document.getElementById('modalName').textContent = name;
    document.getElementById('modalEmail').textContent = email;
    document.getElementById('modalPhone').textContent = phone;
    document.getElementById('modalAddress').textContent = address;
    document.getElementById('modalProfession').textContent = profession;
    document.getElementById('modalSpecialization').textContent = specialization;
    document.getElementById('modalExperience').textContent = experience;
    document.getElementById('modalStartDate').textContent = startDate;
    document.getElementById('modalLicenseNumber').textContent = licenseNumber;
    document.getElementById('modalResume').href = resumeUrl;
    document.getElementById('modalLicense').href = licenseUrl;
    document.getElementById('modalCertifications').href = certificationsUrl;
    document.getElementById('snapshotButton').href = `/admin/applications/${applicationId}/snapshot`;
    document.getElementById('pdfButton').href = `/admin/applications/${applicationId}/pdf`;
}

document.getElementById('approveButton').addEventListener('click', async () => {
    if (!currentApplicationId) return;
    try {
        const response = await fetch(`/admin/applications/${currentApplicationId}/approve`, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
                'Accept': 'application/json'
            }
        });
        const result = await response.json();
        alert(result.message || 'Application approved.');
        location.reload();
    } catch (error) {
        alert('Failed to approve application.');
    }
});

document.getElementById('rejectButton').addEventListener('click', async () => {
    if (!currentApplicationId) return;
    const reason = prompt('Enter rejection reason:');
    if (reason === null) return; // User cancelled
    try {
        const response = await fetch(`/admin/applications/${currentApplicationId}/reject`, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ reason })
        });
        const result = await response.json();
        alert(result.message || 'Application rejected.');
        location.reload();
    } catch (error) {
        alert('Failed to reject application.');
    }
});

document.getElementById('passwordButton').addEventListener('click', async () => {
    if (!currentApplicationId) return;
    try {
        const response = await fetch(`/admin/applications/${currentApplicationId}/regenerate-password`, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').getAttribute('content'),
                'Accept': 'application/json'
            }
        });
        const result = await response.json();
        alert(result.message || 'Password generated.');
    } catch (error) {
        alert('Failed to generate password.');
    }
});
</script>
