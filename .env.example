sudo tee /var/www/Matendo/.env > /dev/null <<'EOF'
# =====================================================================
# Production .env for matendohealth.com
# Do NOT commit this file. Permissions: 640, owner www-data:www-data.
# =====================================================================

APP_ENV=production
APP_URL=https://matendohealth.com
APP_DEBUG=false

# --- Database (same EC2 instance) ------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matendo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- App secrets (already generated — do not regenerate or you will
#     invalidate every session and decrypt every PHI field as garbage) -
APP_KEY=iG1OijU0yn4iR7tdVdZqVvqTY2i8RjTV4coIKo1Ct6I=
APP_PEPPER=b847fee100bd275fc7037d3bf5437a5c8149c6d6ad74e314fba5769134a841b3

# --- Mail ------------------------------------------------------------
# Outbound mail uses the local MTA (PHP mail()).
# Install postfix once if not already present:
#   sudo apt install -y postfix mailutils    (choose "Internet Site")
# Set system mail name to matendohealth.com.
# Add SPF + DKIM DNS records at Namecheap for deliverability.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=info@matendohealth.com
MAIL_PASS=
MAIL_FROM=info@matendohealth.com
MAIL_FROM_NAME="Matendo Health"
CONTACT_EMAIL=info@matendohealth.com

# --- Cloudflare Turnstile (optional — leave blank to skip) -----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upload limits (10 MB) -------------------------------------------
UPLOAD_MAX_BYTES=10485760
EOF

sudo chown www-data:www-data /var/www/Matendo/.env
sudo chmod 640 /var/www/Matendo/.env
