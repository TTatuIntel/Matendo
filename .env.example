# =====================================================================
# .env template — copy to .env and fill in. Never commit .env.
# For PRODUCTION (matendohealth.com on EC2), use .env.production.example.
# =====================================================================

APP_ENV=development
APP_URL=http://localhost/tattuintel/Matendo
APP_DEBUG=true

# --- Database (XAMPP defaults) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matendo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- App secrets -----------------------------------------------------
# Generate with:
#   php -r "echo base64_encode(random_bytes(32));"   # APP_KEY
#   php -r "echo bin2hex(random_bytes(32));"          # APP_PEPPER
APP_KEY=
APP_PEPPER=

# =====================================================================
# Mail — single mailbox handles everything in/out
# =====================================================================
# In development, send_mail() writes to storage/logs/mail.log instead
# of dispatching, so SMTP creds aren't required locally.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=info@matendohealth.com
MAIL_PASS=

# Outbound FROM address (password resets, replies, notifications)
MAIL_FROM=info@matendohealth.com
MAIL_FROM_NAME="Matendo Health"

# Inbound TO address (contact form forwards, abuse reports)
CONTACT_EMAIL=info@matendohealth.com

# --- Cloudflare Turnstile (optional bot protection) ------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upload limits (bytes) -------------------------------------------
UPLOAD_MAX_BYTES=10485760
