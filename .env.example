# Copy this to .env on the host and fill in the real values.
# Generate APP_KEY:    php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
# Generate APP_PEPPER: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"

APP_ENV=production
APP_URL=https://matendohealth.com
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matendo
DB_USER=matendo_app
DB_PASS=
DB_CHARSET=utf8mb4

APP_KEY=
APP_PEPPER=

MAIL_FROM=info@matendohealth.com
MAIL_FROM_NAME="Matendo Health"
CONTACT_EMAIL=info@matendohealth.com

UPLOAD_MAX_BYTES=10485760
