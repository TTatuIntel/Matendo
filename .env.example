# Copy to .env and fill in. Never commit .env.
APP_ENV=development
APP_URL=http://localhost/tattuintel/Matendo
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matendo
DB_USER=matendo_app
DB_PASS=change_me_strong_password
DB_CHARSET=utf8mb4

# 32-byte base64 key. Generate with:
#   php -r "echo base64_encode(random_bytes(32));"
APP_KEY=

# Hash pepper for passwords (separate from APP_KEY).
APP_PEPPER=

# Mail (use a real SMTP service; do not relay through localhost in prod).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@matendo.com
MAIL_FROM_NAME="Matendo Medics"

# Cloudflare Turnstile (free hCaptcha alternative).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upload limits (bytes).
UPLOAD_MAX_BYTES=10485760
