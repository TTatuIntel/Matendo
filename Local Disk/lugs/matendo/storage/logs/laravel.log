<div class="relative mt-1">
    <input 
        id="approvalModalPassword" 
        type="password" 
        readonly 
        class="block w-full rounded-md border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
        aria-describedby="password-description"
    >
    <button 
        type="button"
        id="togglePassword"
        class="absolute inset-y-0 right-10 pr-3 flex items-center text-emerald-600 hover:text-emerald-800"
        aria-label="Toggle password visibility"
    >Show</button>
    <button 
        type="button"
        onclick="copyToClipboard('approvalModalPassword')"
        class="absolute inset-y-0 right-0 pr-3 flex items-center text-emerald-600 hover:text-emerald-800 group"
        title="Copy password"
        aria-label="Copy password to clipboard"
    >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6a2 2 0 002-2V9m-4-4H6a2 2 0 00-2 2v10"/>
        </svg>
        <span class="tooltip">Copy</span>
    </button>
</div>

<!-- New button to trigger PDF generation -->
<div class="mt-4">
    <button 
        type="button"
        id="generatePdfButton"
        class="rounded-md bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        aria-label="Generate PDF form"
    >
        Generate PDF Form
    </button>
</div>  
