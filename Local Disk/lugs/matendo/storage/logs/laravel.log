Content-Type: text/html; charset=utf-8
Content-Transfer-Encoding: quoted-printable

<!-- Modal backdrop -->
<div 
    id="credentialModal" 
    class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden"
    aria-modal="true" role="dialog" aria-labelledby="credentialModalTitle"
>
    <!-- Modal box -->
    <div class="bg-white rounded-lg shadow-lg max-w-md w-full p-6 relative">
        <!-- Title -->
        <h2 id="credentialModalTitle" class="text-xl font-semibold mb-4 text-emerald-700">
            Account Credentials
        </h2>

        <!-- Password display -->
        <div class="relative mb-4">
            <label for="modalPassword" class="block font-medium text-gray-700 mb-1">Password</label>
            <input 
                type="password" 
                id="modalPassword" 
                readonly
                class="w-full rounded border border-gray-300 p-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                aria-describedby="passwordHelp"
            >
            <button 
                type="button"
                id="togglePasswordBtn"
                class="absolute top-8 right-3 text-emerald-600 hover:text-emerald-800"
                aria-label="Toggle password visibility"
            >
                Show
            </button>
        </div>

        <!-- Buttons -->
        <div class="flex space-x-3 mb-4">
            <button 
                type="button"
                id="regeneratePasswordBtn"
                class="flex-1 bg-emerald-600 text-white py-2 rounded hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
                Regenerate Password
            </button>

            <button 
                type="button"
                id="viewPdfBtn"
                class="flex-1 bg-gray-200 text-gray-800 py-2 rounded hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            >
                View PDF
            </button>
        </div>

        <!-- Close button -->
        <div class="text-right">
            <button 
                type="button" 
                id="closeCredentialModalBtn"
                class="text-gray-600 hover:text-gray-800 focus:outline-none"
                aria-label="Close modal"
            >
                Close
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('credentialModal');
    const passwordInput = document.getElementById('modalPassword');
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const regenerateBtn = document.getElementById('regeneratePasswordBtn');
    const viewPdfBtn = document.getElementById('viewPdfBtn');
    const closeBtn = document.getElementById('closeCredentialModalBtn');

    let currentPassword = '';
    let applicationId = null;

    // Toggle password visibility
    toggleBtn.addEventListener('click', () => {
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleBtn.textContent = 'Hide';
        } else {
            passwordInput.type = 'password';
            toggleBtn.textContent = 'Show';
        }
    });

    // Close modal function
    function closeModal() {
        modal.classList.add('hidden');
        passwordInput.type = 'password';
        toggleBtn.textContent = 'Show';
        passwordInput.value = '';
        currentPassword = '';
        applicationId = null;
    }
    closeBtn.addEventListener('click', closeModal);

    // Regenerate password function
    regenerateBtn.addEventListener('click', () => {
        if (!applicationId) {
            alert('Application ID not set.');
            return;
        }
        regenerateBtn.disabled = true;
        regenerateBtn.textContent = 'Regenerating...';

        fetch(`/admin/applications/${applicationId}/regenerate-password`, {
            method: 'POST',
            headers: {
                'X-CSRF-TOKEN': 'H2NtYHP2OtBg8vg4EsYRY8jjhI9FFVO9uzNiz4WO',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ application_id: applicationId })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.new_password) {
                currentPassword = data.new_password;
                passwordInput.value = currentPassword;
                alert('Password regenerated successfully.');
            } else {
                alert('Failed to regenerate password.');
            }
        })
        .catch(() => alert('An error occurred.'))
        .finally(() => {
            regenerateBtn.disabled = false;
            regenerateBtn.textContent = 'Regenerate Password';
        });
    });

    // View PDF button handler
    viewPdfBtn.addEventListener('click', () => {
        if (!applicationId) {
            alert('Application ID not set.');
            return;
        }
        window.open(`/admin/applications/${applicationId}/pdf`, '_blank');
    });

    // Expose function globally to open modal with data
    window.openCredentialModal = function(password, appId) {
        currentPassword = password;
        applicationId = appId;

        passwordInput.value = currentPassword;
        modal.classList.remove('hidden');
    }
});
</script>
  
