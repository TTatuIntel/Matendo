# =====================================================================
# Production .env template for matendohealth.com
# Copy this file to .env on the server, then fill in the real secrets:
#     cp .env.production.example .env
#     nano .env
# Generate APP_KEY:    php -r "echo base64_encode(random_bytes(32)).PHP_EOL;"
# Generate APP_PEPPER: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# =====================================================================

APP_ENV=production
APP_URL=https://matendohealth.com
APP_DEBUG=false

# --- Database --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=matendo
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- App secrets (generate fresh ones — DO NOT reuse dev values) -----
APP_KEY=GENERATE_WITH_php_-r_echo_base64_encode_random_bytes_32
APP_PEPPER=GENERATE_WITH_php_-r_echo_bin2hex_random_bytes_32

# =====================================================================
# Mail — single mailbox handles everything in/out for matendohealth.com
# =====================================================================
# Outbound delivery: PHP's mail() relays through the local MTA.
# On Ubuntu install postfix:  sudo apt install -y postfix
#   - Choose "Internet Site" and set the system mail name to matendohealth.com
# For better deliverability, add SPF + DKIM DNS records for the domain.
#
# If you instead use a third-party SMTP relay (Mailgun, SES, Postmark),
# install PHPMailer / Symfony Mailer and read MAIL_HOST/PORT/USER/PASS.
# These keys are read but not yet wired to a relay library.
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USER=info@matendohealth.com
MAIL_PASS=YOUR_SMTP_PASSWORD

# All outbound mail (password resets, signup confirmations, replies)
# is sent FROM this address.
MAIL_FROM=info@matendohealth.com
MAIL_FROM_NAME="Matendo Health"

# All inbound notifications (contact form submissions, alerts) are
# delivered TO this address. Same mailbox in our setup.
CONTACT_EMAIL=info@matendohealth.com

# --- Cloudflare Turnstile (optional bot protection) ------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upload limits ---------------------------------------------------
UPLOAD_MAX_BYTES=10485760
