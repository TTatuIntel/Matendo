# =====================================================================
# Matendo Health — root .htaccess
# Works for both:
#   - XAMPP dev:  http://localhost/tattuintel/Matendo/
#   - Production: served at the domain root from /var/www/Matendo
#
# This file ONLY governs requests inside the Matendo directory. It does
# NOT make Matendo a catch-all for other sites — that's a vhost concern
# (see deploy/matendo.conf and the deploy notes).
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^\.env|composer\.(json|lock)|package\.json|\.gitignore|README\.md)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 (?:^|/)(config|includes|sql|storage|deploy)(/|$)

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com data:; script-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php             Off
    php_flag display_errors         Off
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
    php_value session.use_strict_mode 1
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg     "access plus 30 days"
    ExpiresByType image/png      "access plus 30 days"
    ExpiresByType image/webp     "access plus 30 days"
    ExpiresByType image/svg+xml  "access plus 30 days"
    ExpiresByType text/css       "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2     "access plus 30 days"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Root and /home → public/index.php  (MUST come before the pass-through,
    # otherwise the bare directory matches -d and 403s.)
    RewriteRule ^$           public/index.php [L,QSA]
    RewriteRule ^home/?$     public/index.php [L,QSA]

    # Drop .php from URLs (skip api/ since JS posts directly).
    RewriteCond %{THE_REQUEST} \s/(?:[^?\s]*/)?(?!api/)([^?\s]+)\.php[?\s] [NC]
    RewriteRule ^(?!api/)(.+?)\.php$ /$1 [R=301,L,QSA]

    # Pass real files / dirs through (assets, images, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /auth/<x>, /api/<x>, /legal/<x> → that folder's <x>.php
    RewriteRule ^(auth|api|legal)/([a-zA-Z0-9_-]+)$ $1/$2.php [L,QSA]

    # Top-level /<x> → public/<x>.php
    RewriteRule ^([a-zA-Z0-9_-]+)$ public/$1.php [L,QSA]

    # Old .html bookmarks → clean URL
    RewriteRule ^index\.html$    /         [R=301,L]
    RewriteRule ^about\.html$    /about    [R=301,L]
    RewriteRule ^contact\.html$  /contact  [R=301,L]
    RewriteRule ^careers\.html$  /careers  [R=301,L]
    RewriteRule ^hire\.html$     /hire     [R=301,L]
    RewriteRule ^join\.html$     /join     [R=301,L]
</IfModule>
