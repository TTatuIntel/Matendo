# =====================================================================
# Matendo Medics — root .htaccess
# Security hardening, headers, friendly URLs.
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

# --- Security: deny access to sensitive files ------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^\.env|composer\.(json|lock)|package\.json|\.gitignore|\.gitattributes|README\.md)$">
    Require all denied
</FilesMatch>

# Deny direct access to non-public folders even if rewrite is off.
RedirectMatch 403 ^/tattuintel/Matendo/(config|includes|sql|storage)(/|$)

# --- Security headers ------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    # Tighten as you add CDNs / inline scripts.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com data:; script-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Enable HSTS only when running over HTTPS in production.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# --- HTTPS redirect (enable in production) ---------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- PHP hardening ---------------------------------------------------
<IfModule mod_php.c>
    php_flag expose_php Off
    php_flag display_errors Off
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
    php_value session.use_strict_mode 1
</IfModule>

# --- Caching for static assets --------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png  "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# --- Friendly URLs (.php optional) ----------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /tattuintel/Matendo/

    # Redirect old .html URLs to new .php pages (clients with bookmarks).
    RewriteRule ^index\.html$    index.php   [R=301,L]
    RewriteRule ^about\.html$    about.php   [R=301,L]
    RewriteRule ^contact\.html$  contact.php [R=301,L]
    RewriteRule ^careers\.html$  careers.php [R=301,L]
    RewriteRule ^hire\.html$     hire.php    [R=301,L]
    RewriteRule ^join\.html$     join.php    [R=301,L]

    # Allow extensionless URLs: /about → /about.php
    RewriteCond %{REQUEST_FILENAME}     !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>
